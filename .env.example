# =====================================================================
# Projeto DimDim - Grupo lupeol
# MODELO de variaveis de ambiente para a VALIDACAO LOCAL (Fase 4).
#
# Este arquivo E versionado e NAO contem nenhum valor real.
# Copie-o para .env e preencha, ou rode: ./scripts/00_local-env.sh
#
# O .env real esta no .gitignore e nunca deve ser commitado.
#
# ATENCAO: estas credenciais valem SOMENTE para o ambiente local em
# Docker. Na nuvem, as senhas sao geradas e guardadas no Azure Key Vault
# (scripts/04_key-vault.sh) e chegam aos ACIs por
# --secure-environment-variables. Sao valores diferentes, de proposito.
# =====================================================================

# Senha do usuario root do MySQL (container local)
MYSQL_ROOT_PASSWORD=

# Senha do usuario de aplicacao user_dimdim (container local)
MYSQL_PASSWORD=
